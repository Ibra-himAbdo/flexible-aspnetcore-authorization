@page "/admin/users"
@namespace FlexibleAuthorization.Client.Pages.Users
@attribute [Authorize(Permissions.ViewUsers | Permissions.ManageUsers)]

<PageTitle>Users</PageTitle>

<h1>Users</h1>

<p>This is a description.</p>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}

<table class="table table-striped table-hover w-75">
    <thead>
    <tr>
        <th>Username</th>
        <th>Email</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (UserDto user in Users)
    {
        <tr>
            <td>@user.UserName</td>
            <td>@user.Email</td>
            <td>
                <FlexibleAuthorizeView Permissions="@Permissions.ManageUsers">
                    <a class="btn btn-sm btn-secondary" href="/admin/users/@user.Id">
                        <i class="fas fa-edit me-1"></i> Edit
                    </a>
                </FlexibleAuthorizeView>
            </td>
        </tr>
    }
    </tbody>
</table>